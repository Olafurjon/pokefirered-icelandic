    .string "Komdu hvenær sem þú vilt.$"

CeruleanCity_House1_Text_AttackStatFlash::
    .string "ÁRÁS gildi allra vasaskrímslanna\n"
    .string "þinna hækkar örlítið.\p"
    .string "Það leyfir þér líka að nota FLASH\n"
    .string "utan bardaga.$"

