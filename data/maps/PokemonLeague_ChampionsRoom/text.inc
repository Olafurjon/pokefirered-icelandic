PokemonLeague_ChampionsRoom_Text_Intro::
    .string "{RIVAL}: Hæ, {PLAYER}!\p"
    .string "Ég hlakkaði til að sjá þig,\n"
    .string "{PLAYER}.\p"
    .string "Keppinautur minn þarf að vera\n"
    .string "sterkur til að halda mér beittum.\p"
    .string "Meðan ég vann í VasaDEX-inu leitaði\n"
    .string "ég alls staðar að Vasaskrímslum.\p"
    .string "Ekki nóg með það, ég setti saman\n"
    .string "lið sem sigra hvaða Vasaskrímsla-\p"
    .string "gerð sem er.\p"
    .string "Og núna…\p"
    .string "Ég er MEISTARI\n"
    .string "VASASKRÍMSLADEILDARINNAR!\p"
    .string "{PLAYER}! Veistu hvað það\n"
    .string "þýðir?\p"
    .string "Ég skal segja þér það.\p"
    .string "Ég er öflugasti ÞJÁLFARI\n"
    .string "í heimi!$"

PokemonLeague_ChampionsRoom_Text_RematchIntro::
    .string "{RIVAL}: Hæ, {PLAYER}!\p"
    .string "Þú komst aftur, {PLAYER}! Hahaha,\n"
    .string "það er frábært!\p"
    .string "Keppinautur minn þarf að vera\n"
    .string "sterkur til að halda mér beittum.\p"
    .string "Meðan ég vann í VasaDEX-inu leitaði\n"
    .string "ég alls staðar að Vasaskrímslum.\p"
    .string "Ekki nóg með það, ég setti saman\n"
    .string "lið sem sigra hvaða Vasaskrímsla-\p"
    .string "gerð sem er.\p"
    .string "Og núna…\p"
    .string "Ég er MEISTARI\n"
    .string "VASASKRÍMSLADEILDARINNAR!\p"
    .string "{PLAYER}! Veistu hvað það\n"
    .string "þýðir?\p"
    .string "Ég skal segja þér það.\p"
    .string "Ég er öflugasti ÞJÁLFARI\n"
    .string "í heimi!$"

PokemonLeague_ChampionsRoom_Text_Defeat::
    .string "NEI! Þetta getur ekki verið! Þú\n"
    .string "sigraðir mig þegar ég var bestur!\p"
    .string "Eftir alla vinnuna til að verða\n"
    .string "DEILDARMEISTARI?\p"
    .string "Er veldi mitt þegar búið? Þetta er\n"
    .string "ósanngjarnt!$"

PokemonLeague_ChampionsRoom_Text_Victory::
    .string "Hahaha! Ég vann! Ég vann! Ég vann!\p"
    .string "Ég er ekki sá sem tapar fyrir\n"
    .string "{PLAYER}!\p"
    .string "Samt, gegn snillingnum {RIVAL} í\n"
    .string "Vasaskrímslum stóðstu þig vel!\p"
    .string "Ég hrósa þér! Ha! Hahaha!$"

PokemonLeague_ChampionsRoom_Text_PostBattle::
    .string "Af hverju? Af hverju tapaði ég?\p"
    .string "Ég gerði aldrei mistök við að ala\n"
    .string "upp Vasaskrímslin mín…\p"
    .string "Fjárinn! Þú ert nú MEISTARI\n"
    .string "VASASKRÍMSLADEILDARINNAR!\p"
    .string "Þó mér sé illa við að viðurkenna það…$"

PokemonLeague_ChampionsRoom_Text_OakPlayer::
    .string "EIK: {PLAYER}!$"

PokemonLeague_ChampionsRoom_Text_OakCongratulations::
    .string "EIK: Svo þú vannst! Innilega til\n"
    .string "hamingju!\p"
    .string "Þú ert nú MEISTARI\n"
    .string "VASASKRÍMSLADEILDARINNAR!\p"
    .string "Þú hefur þroskast svo mikið síðan þú\n"
    .string "fórst fyrst með {STR_VAR_1} að vinna\p"
    .string "í VasaDEX-inu.\p"
    .string "{PLAYER}, þú hefur fullorðnast!$"

PokemonLeague_ChampionsRoom_Text_OakImDisappointedRival::
    .string "EIK: {RIVAL}… Ég er vonsvikinn með\n"
    .string "þig.\p"
    .string "Ég kom þegar ég heyrði að þú hefðir\n"
    .string "sigrað ELÍTUFERNINGINN.\p"
    .string "En þegar ég kom hingað varstu þegar\n"
    .string "búinn að tapa!\p"
    .string "{RIVAL}, skilurðu hvers vegna þú\n"
    .string "tapaðir?\p"
    .string "Þú gleymdir að koma fram við\n"
    .string "Vasaskrímslin þín af ást og trausti.\p"
    .string "Án þess verðurðu aldrei MEISTARI\n"
    .string "aftur!$"

PokemonLeague_ChampionsRoom_Text_OakPlayerComeWithMe::
    .string "EIK: {PLAYER}.\p"
    .string "Þú skilur að sigurinn var ekki bara\n"
    .string "þitt eigið verk.\p"
    .string "Tengslin sem þú átt við\n"
    .string "Vasaskrímslin þín eru stórkostleg.\p"
    .string "{PLAYER}! Komdu með mér!$"
