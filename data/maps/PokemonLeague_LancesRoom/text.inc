PokemonLeague_LancesRoom_Text_Defeat::
    .string "Þetta er það!\p"
    .string "Mér er illa við að viðurkenna það,\n"
    .string "en þú ert Vasaskrímsla-meistari!$"

PokemonLeague_LancesRoom_Text_PostBattle::
    .string "Ég trúi enn ekki að drekarnir mínir\n"
    .string "hafi tapað fyrir þér, {PLAYER}.\p"
    .string "Þú ert nú MEISTARI\n"
    .string "VASASKRÍMSLADEILDARINNAR!\p"
    .string "…Eða þú værir það, en ein áskorun\n"
    .string "er enn eftir.\p"
    .string "Það er einn ÞJÁLFARI eftir!\n"
    .string "Hann heitir…\p"
    .string "{RIVAL}!\p"
    .string "Hann sigraði ELÍTUFERNINGINN á undan þér.\p"
    .string "Hann er hinn sanni MEISTARI\n"
    .string "VASASKRÍMSLADEILDARINNAR.$"
