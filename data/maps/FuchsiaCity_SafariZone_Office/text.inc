FuchsiaCity_SafariZone_Office_Text_PrizeInSafariZone::
    .string "VÖRÐURINN SLJÓN stendur nú fyrir\n"
    .string "kynningarátaki.\p"
    .string "Reyndu að komast í fjarlægasta horn\n"
    .string "SAFARI SVÆÐISINS.\p"
    .string "Ef þér tekst það færðu mjög\n"
    .string "nytsamleg verðlaun.$"

